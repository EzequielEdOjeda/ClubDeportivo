<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Datos de conexión al entorno local (XAMPP / MySQL Workbench): servidor, puerto, base, usuario y clave -->
    <add name="ClubDeportivoDB"
         connectionString="Server=localhost;Port=3306;Database=Proyecto;Uid=root;Pwd=;SslMode=none;"
         providerName="MySql.Data.MySqlClient" />
  </connectionStrings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
